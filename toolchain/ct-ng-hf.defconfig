CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="/build/x-tools/${CT_TARGET}"
CT_LOCAL_TARBALLS_DIR="/build/tarballs"
CT_SAVE_TARBALLS=y
CT_WORK_DIR="/build/ctng-work"
CT_ARCH_ARM=y
CT_ARCH_CPU="cortex-a9"
CT_ARCH_FPU="neon-fp16"
CT_ARCH_FLOAT_HW=y
CT_ARCH_ARM_MODE_THUMB=y
CT_TARGET_VENDOR="webos"
CT_KERNEL_LINUX=y
CT_LINUX_V_4_4=y
CT_GLIBC_V_2_28=y
CT_GCC_V_14=y
CT_CC_LANG_CXX=y
CT_LOG_EXTRA=y
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="3.2.0"
